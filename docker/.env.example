# Copy to docker/.env and fill in. `docker compose` auto-loads docker/.env.

# --- Weights & Biases ---
WANDB_API_KEY=your_wandb_api_key
WANDB_BASE_URL=https://api.wandb.ai
WANDB_TEAM_NAME=your_team
WANDB_PROJECT=lingbot-va-droid

# --- Run config ---
NGPU=8
CONFIG_NAME=droid_train

# --- Host paths bind-mounted into the container ---
# The single-scene LeRobot latent dataset built by droid_helpers/build_droid_lerobot.py
DATASET_DIR=../data/droid_lerobot
# Dir containing lingbot-va-base/ (transformer/vae/text_encoder/tokenizer)
CKPT_DIR=../checkpoints
# Where checkpoints/logs are written
OUTPUT_DIR=../outputs
# Raw DROID 1.0.1 episodes — only needed to BUILD the dataset (mounted read-only)
DROID_DIR=../1.0.1
